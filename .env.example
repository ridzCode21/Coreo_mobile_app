# Copy to .env and fill in for local development. EXPO_PUBLIC_* vars are inlined at build time
# and are NOT secret — never put real secrets behind an EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=https://vesselled-maxton-ringlike.ngrok-free.dev/api/v1

# mock | live — mock is the dev default; see docs/implementation-plan.md §2.
EXPO_PUBLIC_API_MODE=mock

# Google sign-in (issue #13) — only used when EXPO_PUBLIC_API_MODE=live. Client IDs are public, not
# secret. Replace every PLACEHOLDER; changing these needs a new development build (native config).
# Web client ID: the SAME "Web application" OAuth client ID the backend uses as GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=PLACEHOLDER-WEB-CLIENT-ID.apps.googleusercontent.com
# iOS client ID: the "iOS" OAuth client created for bundle ID com.coreo.app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=PLACEHOLDER-IOS-CLIENT-ID.apps.googleusercontent.com
# iOS URL scheme: the iOS client ID reversed, i.e. com.googleusercontent.apps.<the part before
# .apps.googleusercontent.com in the iOS client ID>.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.PLACEHOLDER-IOS-CLIENT-ID
